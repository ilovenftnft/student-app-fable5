<?xml version="1.0" encoding="UTF-8"?>
<!-- 开机自启（孩子的 Mac）。复制到 ~/Library/LaunchAgents/com.studyapp.server.plist，改两处路径，然后
     launchctl load ~/Library/LaunchAgents/com.studyapp.server.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.studyapp.server</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string>
    <string>/PATH/TO/student-app/src/server/index.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/student-app</string>
  <key>EnvironmentVariables</key><dict>
    <key>PORT</key><string>8787</string>
    <key>DATA_DIR</key><string>/PATH/TO/student-app/data</string>
    <key>TZ</key><string>Asia/Shanghai</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/PATH/TO/student-app/data/run/server.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/student-app/data/run/server.log</string>
</dict></plist>
