{
  "name": "student-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "node src/server/content/sim-cli.ts",
    "load": "node src/server/content/load-cli.ts",
    "verify": "node src/server/content/load-cli.ts --dry-run",
    "load:chapters": "node src/server/content/chapters-cli.ts",
    "dev": "node --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh",
    "stop": "bash scripts/deploy.sh stop"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.13.5",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
